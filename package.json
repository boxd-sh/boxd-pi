{
  "name": "@boxd-sh/pi",
  "version": "0.1.0",
  "description": "Pi extension that runs Pi's tools inside a boxd machine while the agent runs on your computer",
  "type": "module",
  "license": "MIT",
  "author": "boxd <contact@boxd.sh>",
  "homepage": "https://boxd.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boxd-sh/boxd-pi.git"
  },
  "bugs": {
    "url": "https://github.com/boxd-sh/boxd-pi/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "coding-agent",
    "boxd",
    "sandbox",
    "microvm"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/boxd-sh/boxd-pi/main/assets/banner.png"
  },
  "files": [
    "index.ts",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run smoke",
    "test:live": "node scripts/live.mjs"
  },
  "dependencies": {
    "@boxd-sh/sdk": "^0.3.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.20.5",
    "typebox": "^1.4.6",
    "typescript": "^5.9.3"
  }
}
